<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.jswone.demo</groupId>
    <artifactId>demo-boot3</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <!--
      Local exercise harness for central-observability-utility. Deliberately NOT a module of the
      library build: it inherits a Boot parent, is never published, and depends on the starter
      exactly as a real service does (so `mvn install` in the repo root must run first).
    -->

    <properties>
        <java.version>21</java.version>
        <central-observability.version>0.1.0-SNAPSHOT</central-observability.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jswone.observability</groupId>
            <artifactId>central-observability-utility</artifactId>
            <version>${central-observability.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Pushes Micrometer meters (including the ErrorEventLogger observation) to the
             collector over OTLP. The javaagent does not see Micrometer meters. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
