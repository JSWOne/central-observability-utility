<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <!--
      No <Rewrite> here: masking happens in PiiMaskingLogEventFactory, enabled by the
      -Dlog4j2.logEventFactory JVM argument in the Dockerfile. That runs before LoggerConfig
      hands the event to any appender, including the javaagent's OTLP log appender, so the
      export is redacted too.
    -->
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{36} trace=%X{traceId} span=%X{spanId} req=%X{requestId} : %msg%n%ex"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
